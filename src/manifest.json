{
  "manifest_version": 3,
  "name": "Caxumba Video Saver",
  "version": "0.1.0",
  "description": "Detecta videos MP4 e HLS (.m3u8) servidos diretamente por uma pagina e permite baixa-los, sem servidor externo.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Caxumba Video Saver"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["webRequest", "downloads", "storage", "tabs", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
